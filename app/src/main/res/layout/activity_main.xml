<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainbg"
    android:fitsSystemWindows="true">

    <!-- 开始界面 -->
    <LinearLayout
        android:id="@+id/start_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_start"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/btn_start_bg"
            android:contentDescription="@string/start_game"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_start_fg" />

        <ImageView
            android:id="@+id/iv_title"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/bg_title" />
    </LinearLayout>

    <!-- 游戏界面 -->
    <LinearLayout
        android:id="@+id/game_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btn_exit"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/dialog_exit"
                android:contentDescription="@string/dialog_exit"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="第 1 关" />

            <ImageView
                android:id="@+id/iv_clock"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/left_time"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_clock" />

            <ProgressBar
                android:id="@+id/progress_time"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressBackgroundTint="@color/progress_track"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="64dp"
                android:gravity="end"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/game_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/tool_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="36dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_disrupt"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/btn_disrupt"
                    android:contentDescription="@string/tool_disrupt"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/tv_disrupt_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="×3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_tip"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/btn_tip"
                    android:contentDescription="@string/tool_tip"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/tv_tip_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="×3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
